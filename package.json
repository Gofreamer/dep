{
  "name": "jet-tcg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JET TCG — jogo de cartas competitivo (agente vs IA) com engine genérica data-driven.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:long": "JET_LONG_TESTS=1 vitest run tests/jet-matches.test.ts",
    "test:every-card": "vitest run tests/every-card-playable.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "check": "npm run typecheck && npm run typecheck:worker && npm test && npm run test:long && npm run test:fuzz:long && npm run build",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "test:worker": "node scripts/run-worker-tests.mjs",
    "test:fuzz": "vitest run tests/fuzz-matches.test.ts",
    "test:fuzz:long": "JET_LONG_TESTS=1 JET_FUZZ_MATCHES=1000 vitest run tests/fuzz-matches.test.ts",
    "meta:sim": "tsx scripts/meta-sim.ts",
    "ranked:sim": "tsx scripts/bot-ladder-sim.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
