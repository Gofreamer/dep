+  return fn;
+}
+
+/** Todos os ops registrados (para validação estrutural de dados). */
+export function allOps(): string[] {
+  return Object.keys(ops);
+}
+
+export function hasOp(name: string): boolean {
+  return ops[name] !== undefined;
+}
