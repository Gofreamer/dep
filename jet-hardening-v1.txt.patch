@@ -0,0 +1,604 @@
+/* ==========================================================================
+   NEXO — identidade visual: TCG digital futurista (anime), tema escuro neon
+   ========================================================================== */
+
+:root {
+  --bg0: #070a14;
+  --bg1: #0b0f1e;
+  --bg2: #111832;
+  --bg3: #182040;
+  --ink: #e8ecff;
+  --ink-dim: #9aa3c7;
+  --cyan: #22d3ee;
+  --magenta: #e879f9;
+  --gold: #fbbf24;
+  --green: #4ade80;
+  --red: #f87171;
+  --line: rgba(148, 163, 255, 0.16);
+  --glass: rgba(17, 24, 50, 0.72);
+  --radius: 14px;
+  --shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
+  --neon: 0 0 10px rgba(34, 211, 238, 0.55), 0 0 26px rgba(232, 121, 249, 0.22);
+}
+
+* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
+html, body, #root { height: 100%; }
+body {
+  background: radial-gradient(1200px 700px at 70% -10%, #1a1442 0%, var(--bg1) 55%, var(--bg0) 100%);
+  color: var(--ink);
+  font-family: 'Segoe UI', system-ui, -apple-system, Roboto, 'Helvetica Neue', sans-serif;
+  overflow: hidden;
+  user-select: none;
+}
+button { font-family: inherit; color: inherit; cursor: pointer; }
+input, select { font-family: inherit; }
+body.shake { animation: bodyShake 0.42s ease; }
+@keyframes bodyShake {
+  0%, 100% { transform: translate(0, 0); }
+  20% { transform: translate(-7px, 3px); }
+  40% { transform: translate(6px, -4px); }
+  60% { transform: translate(-4px, 2px); }
+  80% { transform: translate(3px, -2px); }
+}
+
+.app { height: 100%; }
+.screen { height: 100%; display: flex; flex-direction: column; overflow: hidden auto; padding: 18px; gap: 14px; }
+.loading { margin: auto; color: var(--ink-dim); font-size: 18px; letter-spacing: 0.08em; animation: pulse 1.4s infinite; }
+@keyframes pulse { 50% { opacity: 0.45; } }
+
+/* ---------- botões / formas ---------- */
+.btn {
+  background: var(--bg2); border: 1px solid var(--line); color: var(--ink);
+  padding: 10px 18px; border-radius: 10px; font-size: 14px; font-weight: 600;
+  transition: transform 0.12s, box-shadow 0.2s, border-color 0.2s;
+}
+.btn:hover { transform: translateY(-1px); border-color: rgba(34, 211, 238, 0.5); }
+.btn.primary {
+  background: linear-gradient(135deg, rgba(34, 211, 238, 0.25), rgba(232, 121, 249, 0.25));
+  border-color: rgba(34, 211, 238, 0.6);
+  box-shadow: var(--neon);
+}
+.btn.ghost { background: transparent; }
+.btn.danger { border-color: rgba(248, 113, 113, 0.5); color: #fca5a5; }
+.btn.big { font-size: 17px; padding: 14px 30px; border-radius: 14px; }
+.btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
+.hint { color: var(--ink-dim); font-size: 12.5px; }
+.toast {
+  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
+  background: var(--glass); border: 1px solid var(--line); backdrop-filter: blur(8px);
+  padding: 10px 22px; border-radius: 999px; font-size: 14px; z-index: 400;
+  box-shadow: var(--shadow); animation: toastIn 0.25s ease;
+}
+@keyframes toastIn { from { opacity: 0; transform: translate(-50%, 12px); } }
+
+.screen-head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
+.screen-head h2 { font-size: 22px; letter-spacing: 0.04em; flex: 1; }
+.record-badge { background: var(--bg2); border: 1px solid var(--line); padding: 6px 14px; border-radius: 999px; font-weight: 700; color: var(--gold); }
+
+/* ---------- título ---------- */
+.title-screen { align-items: center; justify-content: center; position: relative; overflow: hidden; }
+.title-art { position: absolute; inset: 0; pointer-events: none; }
+.spark {
+  position: absolute; left: 50%; top: 50%; width: 4px; height: 4px; border-radius: 50%;
+  background: var(--cyan); box-shadow: 0 0 12px var(--cyan);
+  animation: orbit 9s linear infinite;
+  animation-delay: calc(var(--i) * -0.375s);
+  transform: rotate(calc(var(--i) * 15deg)) translateX(38vw);
+  opacity: 0.7;
+}
+@keyframes orbit { to { transform: rotate(calc(var(--i) * 15deg + 360deg)) translateX(38vw); } }
+.title-center { text-align: center; z-index: 1; display: flex; flex-direction: column; gap: 18px; align-items: center; }
+.game-logo {
+  font-size: clamp(56px, 12vw, 120px); letter-spacing: 0.22em; font-weight: 900;
+  background: linear-gradient(120deg, var(--cyan) 20%, var(--magenta) 60%, var(--gold));
+  -webkit-background-clip: text; background-clip: text; color: transparent;
+  filter: drop-shadow(0 0 26px rgba(34, 211, 238, 0.35));
+}
+.game-sub { color: var(--ink-dim); letter-spacing: 0.35em; text-transform: uppercase; font-size: 13px; }
+.title-note { color: var(--ink-dim); font-size: 12px; opacity: 0.7; }
+
+/* ---------- menu ---------- */
+.menu-screen { align-items: center; justify-content: center; gap: 30px; }
+.menu-logo { font-size: 42px; letter-spacing: 0.25em; font-weight: 900; color: transparent; background: linear-gradient(120deg, var(--cyan), var(--magenta)); -webkit-background-clip: text; background-clip: text; }
+.menu-grid { display: grid; grid-template-columns: repeat(3, minmax(180px, 240px)); gap: 16px; }
+.menu-card {
+  display: flex; flex-direction: column; gap: 6px; align-items: flex-start; text-align: left;
+  background: var(--glass); border: 1px solid var(--line); border-radius: var(--radius);
+  padding: 20px; backdrop-filter: blur(10px); transition: transform 0.15s, border-color 0.2s, box-shadow 0.2s;
+}
+.menu-card:hover { transform: translateY(-3px); border-color: rgba(34, 211, 238, 0.55); box-shadow: var(--neon); }
+.menu-card b { font-size: 17px; }
+.menu-card small { color: var(--ink-dim); }
+.menu-card .mc-icon { font-size: 26px; }
+.menu-card.primary { border-color: rgba(232, 121, 249, 0.45); }
+.menu-card.tutorial { border-color: rgba(251, 191, 36, 0.4); }
+
+/* ---------- filtros ---------- */
+.filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
+.filters input, .filters select {
+  background: var(--bg2); border: 1px solid var(--line); color: var(--ink);
+  padding: 8px 12px; border-radius: 9px; font-size: 13px; outline: none;
+}
+.filters input:focus, .filters select:focus { border-color: rgba(34, 211, 238, 0.55); }
+.fav-toggle { display: flex; gap: 6px; align-items: center; font-size: 13px; color: var(--ink-dim); }
+
+/* ---------- deck select ---------- */
+.deck-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
+.deck-option {
+  display: flex; flex-direction: column; gap: 8px; text-align: left; padding: 18px;
+  background: var(--glass); border: 1px solid var(--line); border-radius: var(--radius);
+  transition: transform 0.14s, border-color 0.2s; backdrop-filter: blur(8px);
+}
+.deck-option:hover { transform: translateY(-2px); }
+.deck-option.selected { border-color: var(--cyan); box-shadow: var(--neon); }
+.deck-option.new-deck { border-style: dashed; color: var(--ink-dim); align-items: center; justify-content: center; min-height: 120px; }
+.do-name { font-size: 17px; }
+.do-desc { color: var(--ink-dim); font-size: 12.5px; min-height: 32px; }
+.do-stats { display: flex; gap: 10px; flex-wrap: wrap; font-size: 11.5px; color: var(--cyan); }
+.do-invalid { color: var(--red); font-size: 12px; }
+.match-setup { display: flex; gap: 14px; align-items: end; flex-wrap: wrap; background: var(--glass); border: 1px solid var(--line); padding: 16px 18px; border-radius: var(--radius); }
+.match-setup label { display: flex; flex-direction: column; gap: 6px; font-size: 12.5px; color: var(--ink-dim); }
+.match-setup select, .match-setup input {
+  background: var(--bg2); border: 1px solid var(--line); color: var(--ink); padding: 9px 12px; border-radius: 9px; min-width: 150px;
+}
+
+/* ---------- cartas completas ---------- */
+.card-full {
+  width: 268px; background: linear-gradient(160deg, var(--bg2), var(--bg1));
+  border: 1.6px solid var(--faction, var(--line)); border-radius: 16px; padding: 12px;
+  display: flex; flex-direction: column; gap: 8px; position: relative; box-shadow: var(--shadow);
+}
+.card-full.selected { outline: 2px solid var(--cyan); }
+.card-full.dim { opacity: 0.55; filter: grayscale(0.4); }
+.card-full.glow { box-shadow: 0 0 18px rgba(34, 211, 238, 0.6); }
+.card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
+.card-name { font-weight: 800; font-size: 16.5px; letter-spacing: 0.02em; }
+.hp-badge { color: var(--gold); font-weight: 900; font-style: normal; font-size: 17px; }
+.hp-badge small { font-size: 10px; color: var(--ink-dim); margin-left: 2px; }
+.card-stage { display: flex; gap: 6px; flex-wrap: wrap; }
+.chip {
+  font-size: 10.5px; padding: 2.5px 8px; border-radius: 999px;
+  background: rgba(148, 163, 255, 0.1); border: 1px solid var(--line); color: var(--ink-dim); font-weight: 700;
+}
+.kind-chip { color: var(--faction); border-color: var(--faction); }
+.unique-chip { color: var(--gold); border-color: var(--gold); }
+.qty { color: var(--cyan); }
+.card-art { position: relative; border-radius: 10px; overflow: hidden; height: 130px; border: 1px solid var(--line); }
+.art-svg { width: 100%; height: 100%; display: block; }
+.rarity { position: absolute; right: 8px; top: 6px; text-shadow: 0 0 8px currentColor; font-size: 15px; }
+.card-rulebox { font-size: 11.5px; color: var(--ink-dim); background: rgba(148, 163, 255, 0.06); border-left: 3px solid var(--faction); padding: 6px 8px; border-radius: 6px; }
+.card-body { display: flex; flex-direction: column; gap: 6px; min-height: 60px; }
+.ability-line, .attack-line {
+  background: rgba(148, 163, 255, 0.07); border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px;
+  font-size: 11.5px; display: grid; grid-template-columns: auto 1fr auto; gap: 4px 8px; align-items: center;
+}
+.ab-name, .atk-name { grid-column: 1; }
+.ab-trigger { grid-column: 2; color: var(--magenta); font-size: 10px; }
+.ab-text, .atk-text { grid-column: 1 / -1; color: var(--ink-dim); }
+.atk-dmg { grid-column: 3; color: var(--gold); font-weight: 900; font-size: 15px; }
+.atk-cost { grid-column: 1; display: flex; gap: 3px; }
+.cost-pip {
+  display: inline-flex; width: 16px; height: 16px; border-radius: 50%; align-items: center; justify-content: center;
+  font-size: 10px; font-weight: 900; color: #06080f; box-shadow: 0 0 6px rgba(0,0,0,0.5) inset;
+}
+.attack-line { grid-template-columns: auto 1fr auto; }
+.attack-line .atk-name { grid-column: 2; }
+.card-foot { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--ink-dim); border-top: 1px solid var(--line); padding-top: 6px; }
+.weak { color: #fca5a5; } .resist { color: #93c5fd; } .retreat { color: var(--ink-dim); }
+.card-number { position: absolute; bottom: 6px; right: 12px; font-size: 9px; color: var(--ink-dim); opacity: 0.6; }
+.resource-body .res-amount { font-size: 12px; color: var(--ink-dim); }
+
+/* ---------- cartas mini (mão/listas) ---------- */
+.card-mini {
+  display: flex; align-items: center; gap: 10px; padding: 7px 10px; min-width: 200px;
+  background: var(--glass); border: 1px solid var(--line); border-left: 3px solid var(--faction);
+  border-radius: 11px; transition: transform 0.13s, box-shadow 0.18s, border-color 0.18s; position: relative;
+}
+.card-mini:hover { transform: translateY(-4px) scale(1.02); box-shadow: var(--shadow); z-index: 5; }
+.card-mini.playable { border-color: rgba(74, 222, 128, 0.65); box-shadow: 0 0 12px rgba(74, 222, 128, 0.35); cursor: pointer; }
+.card-mini.dim { opacity: 0.45; filter: saturate(0.5); }
+.mini-art { width: 40px; height: 40px; border-radius: 8px; overflow: hidden; flex-shrink: 0; }
+.mini-info { flex: 1; display: flex; flex-direction: column; gap: 3px; }
+.mini-name { font-size: 13px; font-weight: 700; }
+.mini-name em { color: var(--cyan); font-style: normal; }
+.mini-sub { display: flex; gap: 5px; align-items: center; }
+.mini-sub .chip { font-size: 9px; padding: 1.5px 6px; }
+.mini-hp { font-size: 11px; color: var(--gold); font-weight: 800; margin-left: auto; }
+.card-mini .rarity { position: static; font-size: 12px; }
+
+/* ---------- biblioteca / coleção ---------- */
+.builder-layout { display: grid; grid-template-columns: 1fr 330px; gap: 14px; flex: 1; min-height: 0; }
+.library { display: flex; flex-direction: column; gap: 10px; min-height: 0; }
+.lib-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 9px; overflow-y: auto; align-content: start; padding: 4px; flex: 1; }
+.lib-cell { position: relative; }
+.lib-cell.fav::after { content: '★'; position: absolute; top: -6px; right: -4px; color: var(--gold); font-size: 15px; }
+.lib-add {
+  position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
+  background: rgba(34, 211, 238, 0.16); color: var(--cyan); border: 1px solid rgba(34, 211, 238, 0.4);
+  width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900;
+}
+.fav-btn { position: absolute; left: 6px; top: 6px; background: transparent; border: none; color: rgba(251, 191, 36, 0.35); font-size: 15px; }
+.fav-btn.on { color: var(--gold); text-shadow: 0 0 8px var(--gold); }
+.usage-chip { position: absolute; bottom: 6px; right: 6px; font-size: 9.5px; background: rgba(34, 211, 238, 0.14); color: var(--cyan); padding: 1px 7px; border-radius: 999px; }
+.deck-panel { display: flex; flex-direction: column; gap: 10px; min-height: 0; }
+.deck-validity { font-size: 12.5px; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--line); }
+.deck-validity.ok { color: var(--green); border-color: rgba(74, 222, 128, 0.4); }
+.deck-validity.bad { color: #fca5a5; border-color: rgba(248, 113, 113, 0.4); }
+.deck-contents { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 5px; padding-right: 4px; min-height: 120px; }
+.deck-name-input {
+  flex: 1; min-width: 120px; background: transparent; border: none; border-bottom: 2px dashed var(--line);
+  color: var(--ink); font-size: 19px; font-weight: 800; padding: 4px 6px; outline: none;
+}
+.deck-name-input:focus { border-color: var(--cyan); }
+.head-actions { display: flex; gap: 8px; }
+.deck-stats { background: var(--glass); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px; display: flex; flex-direction: column; gap: 6px; }
+.stat-row { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--ink-dim); }
+.stat-row b { color: var(--ink); }
+.curve { border-top: 1px solid var(--line); padding-top: 8px; display: flex; flex-direction: column; gap: 4px; }
+.curve b { font-size: 11.5px; color: var(--magenta); }
+.curve-row { display: grid; grid-template-columns: 68px 1fr 24px; gap: 6px; align-items: center; font-size: 11px; color: var(--ink-dim); }
+.curve-bar { background: rgba(148, 163, 255, 0.1); border-radius: 99px; height: 8px; overflow: hidden; }
+.curve-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--cyan), var(--magenta)); border-radius: 99px; }
+.curve-row em { text-align: right; color: var(--cyan); }
+
+/* ---------- história / ajustes ---------- */
+.history-list { display: flex; flex-direction: column; gap: 8px; }
+.history-line {
+  display: flex; gap: 14px; align-items: center; padding: 12px 16px; background: var(--glass);
+  border: 1px solid var(--line); border-radius: 12px; font-size: 13px; flex-wrap: wrap;
+}
+.history-line .result { font-weight: 900; width: 74px; }
+.history-line .result.win { color: var(--green); }
+.history-line .result.loss { color: var(--red); }
+.matchup { flex: 1; }
+.history-line .meta { color: var(--ink-dim); }
+.history-line .date { color: var(--ink-dim); font-size: 11.5px; }
+.settings-body { display: flex; flex-direction: column; gap: 14px; max-width: 520px; }
+.settings-body label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--ink-dim); }
+.settings-body input, .settings-body select { background: var(--bg2); border: 1px solid var(--line); color: var(--ink); padding: 9px 12px; border-radius: 9px; }
+.settings-body label.check { flex-direction: row; align-items: center; }
+.about { border-top: 1px solid var(--line); padding-top: 12px; color: var(--ink-dim); font-size: 12.5px; line-height: 1.5; }
+
+/* ---------- resultados ---------- */
+.results-screen { align-items: center; justify-content: center; }
+.results-card {
+  text-align: center; background: var(--glass); backdrop-filter: blur(12px); border: 1px solid var(--line);
+  border-radius: 22px; padding: 46px 60px; display: flex; flex-direction: column; gap: 16px; align-items: center;
+  box-shadow: var(--shadow);
+}
+.results-screen.win .results-card { border-color: rgba(74, 222, 128, 0.5); box-shadow: 0 0 40px rgba(74, 222, 128, 0.2); }
+.results-screen.loss .results-card { border-color: rgba(248, 113, 113, 0.4); }
+.results-card h1 { font-size: 44px; letter-spacing: 0.08em; }
+.results-screen.win h1 { color: var(--green); text-shadow: 0 0 24px rgba(74, 222, 128, 0.5); }
+.results-screen.loss h1 { color: var(--red); }
+.results-card p { color: var(--ink-dim); max-width: 420px; }
+.results-actions { display: flex; flex-direction: column; gap: 10px; min-width: 260px; }
+
+/* ==========================================================================
+   PARTIDA
+   ========================================================================== */
+.match-screen { padding: 8px; gap: 6px; position: relative; overflow: hidden; }
+.opp-bar, .my-bar { display: flex; align-items: center; gap: 16px; padding: 4px 10px; }
+.player-name { font-weight: 800; letter-spacing: 0.04em; }
+.ai-tag { color: var(--magenta); font-size: 10px; border: 1px solid rgba(232, 121, 249, 0.4); border-radius: 99px; padding: 1px 7px; margin-left: 6px; }
+.opp-info, .my-info { display: flex; flex-direction: column; gap: 4px; flex: 1; }
+.vp-track { display: flex; gap: 5px; }
+.vp-pip { width: 17px; height: 9px; border-radius: 4px; background: rgba(148, 163, 255, 0.14); border: 1px solid var(--line); }
+.vp-pip.earned { background: linear-gradient(90deg, var(--gold), #f59e0b); box-shadow: 0 0 8px rgba(251, 191, 36, 0.7); border-color: var(--gold); }
+.opp-hand-backs { display: flex; gap: 3px; align-items: center; }
+.hand-back { width: 20px; height: 30px; border-radius: 4px; background: linear-gradient(160deg, #1e2a55, #10162e); border: 1px solid var(--line); }
+.hand-count { color: var(--ink-dim); font-size: 12px; margin-left: 6px; }
+
+.zone-pile { display: flex; flex-direction: column; align-items: center; gap: 2px; cursor: pointer; }
+.pile-visual {
+  width: 46px; height: 62px; border-radius: 8px; position: relative;
+  border: 1px solid var(--line); box-shadow: var(--shadow);
+}
+.zone-pile.deck .pile-visual { background: repeating-linear-gradient(160deg, #1c2650 0 6px, #141c3c 6px 12px); }
+.zone-pile.discard .pile-visual { background: repeating-linear-gradient(160deg, #2a1a2e 0 8px, #1a1220 8px 16px); opacity: 0.8; }
+.pile-count { font-size: 14px; font-weight: 900; color: var(--cyan); }
+.pile-label { font-size: 9.5px; color: var(--ink-dim); text-transform: uppercase; letter-spacing: 0.1em; }
+
+.field-row { display: flex; justify-content: center; }
+.bench-row { display: flex; gap: 10px; align-items: stretch; }
+.active-row { align-items: center; gap: 20px; }
+.active-zone { width: min(320px, 30vw); }
+.slot.empty {
+  border: 2px dashed rgba(148, 163, 255, 0.22); border-radius: 14px; min-height: 96px;
+  display: flex; align-items: center; justify-content: center; color: var(--ink-dim); font-size: 11px; letter-spacing: 0.12em;
+}
+.slot.empty.active-slot { min-height: 300px; width: 100%; }
+.slot.empty.mini-slot { min-height: 96px; flex: 1; max-width: 150px; }
+
+.center-strip { display: flex; flex-direction: column; align-items: center; gap: 10px; min-width: 190px; }
+.turn-banner {
+  display: flex; flex-direction: column; align-items: center; gap: 6px;
+  background: var(--glass); border: 1px solid var(--line); border-radius: 12px; padding: 10px 18px;
+  font-size: 13.5px; backdrop-filter: blur(6px);
+}
+.turn-banner .my-turn { color: var(--cyan); font-weight: 800; }
+.turn-banner .opp-turn { color: var(--magenta); }
+.field-chip { font-size: 10.5px; color: var(--gold); border: 1px solid rgba(251, 191, 36, 0.35); border-radius: 99px; padding: 2px 10px; }
+.field-slot {
+  display: flex; gap: 8px; min-height: 42px; align-items: center; justify-content: center;
+  border: 1.5px dashed rgba(251, 191, 36, 0.3); border-radius: 12px; padding: 4px 12px; min-width: 190px;
+}
+.field-empty { color: rgba(251, 191, 36, 0.5); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; }
+.field-card {
+  background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.45); color: var(--gold);
+  border-radius: 9px; padding: 7px 14px; font-size: 12px; font-weight: 700;
+}
+
+/* board card */
+.board-card {
+  position: relative; width: 100%; background: linear-gradient(165deg, var(--bg3), var(--bg1));
+  border: 1.6px solid var(--faction); border-radius: 14px; padding: 8px 10px; cursor: pointer;
+  display: flex; flex-direction: column; gap: 5px; transition: transform 0.14s, box-shadow 0.2s;
+  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4);
+}
+.board-card:hover { transform: translateY(-3px); box-shadow: var(--shadow), var(--neon); z-index: 6; }
+.board-card.is-active { padding: 12px 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.5), 0 0 22px color-mix(in srgb, var(--faction) 35%, transparent); }
+.board-card.targetable { outline: 2.5px solid var(--cyan); animation: targetPulse 1.1s infinite; cursor: crosshair; }
+@keyframes targetPulse { 50% { outline-color: rgba(34, 211, 238, 0.25); } }
+.board-card.selected { outline: 2.5px solid var(--magenta); }
+.board-card.can-attack::after {
+  content: '⚔'; position: absolute; top: -8px; right: -6px; font-size: 15px;
+  color: var(--red); text-shadow: 0 0 8px rgba(248, 113, 113, 0.8);
+}
+.board-card.soft-glow { box-shadow: 0 0 14px rgba(74, 222, 128, 0.35); }
+.just-played { position: absolute; top: -7px; left: -6px; font-size: 13px; }
+.bc-top { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; }
+.bc-name { font-weight: 800; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.is-active .bc-name { font-size: 16px; }
+.bc-hp { color: var(--gold); font-weight: 900; font-size: 14px; }
+.bc-hp small { color: var(--ink-dim); font-weight: 400; }
+.bc-hp[data-damaged="true"] { color: var(--red); }
+.bc-art { position: relative; height: 58px; border-radius: 9px; overflow: hidden; border: 1px solid var(--line); }
+.is-active .bc-art { height: 108px; }
+.hp-bar { position: absolute; bottom: 0; left: 0; right: 0; height: 5px; background: rgba(0, 0, 0, 0.55); }
+.hp-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--green), #a3e635); transition: width 0.4s ease; }
+.hp-bar span[data-low="true"] { background: linear-gradient(90deg, var(--red), #fb923c); }
+.dmg-count { position: absolute; top: 4px; right: 6px; font-size: 10px; background: rgba(248, 113, 113, 0.2); color: #fca5a5; padding: 1px 6px; border-radius: 99px; font-weight: 800; }
+.bc-stage { font-size: 10px; color: var(--ink-dim); text-transform: uppercase; letter-spacing: 0.08em; }
+.bc-attacks, .bc-abilities { display: flex; flex-direction: column; gap: 3px; }
+.bc-attack {
+  display: flex; justify-content: space-between; font-size: 11px; padding: 3px 7px;
+  background: rgba(148, 163, 255, 0.07); border-radius: 6px; color: var(--ink-dim);
+}
+.bc-attack.playable { color: var(--ink); border: 1px solid rgba(74, 222, 128, 0.5); }
+.bc-atk-dmg { color: var(--gold); font-weight: 900; }
+.bc-equip { font-size: 10px; color: var(--cyan); }
+.bc-res { display: flex; gap: 4px; min-height: 12px; align-items: center; flex-wrap: wrap; }
+.res-pip { width: 12px; height: 12px; border-radius: 50%; box-shadow: 0 0 6px color-mix(in srgb, currentColor 60%, transparent), inset 0 -2px 3px rgba(0,0,0,0.4); }
+.res-empty { width: 12px; height: 12px; border-radius: 50%; border: 1px dashed rgba(148, 163, 255, 0.3); }
+.bc-status { display: flex; gap: 4px; flex-wrap: wrap; }
+.status-chip {
+  font-size: 11px; background: rgba(148, 163, 255, 0.12); border-radius: 6px; padding: 1px 5px;
+  border: 1px solid var(--line); animation: statusPop 0.3s ease;
+}
+@keyframes statusPop { from { transform: scale(0.4); opacity: 0; } }
+.status-chip.st-burn { color: #fca5a5; border-color: rgba(248, 113, 113, 0.5); }
+.status-chip.st-poison { color: #bef264; border-color: rgba(190, 242, 100, 0.4); }
+.status-chip.st-shield, .status-chip.st-regeneration { color: #93c5fd; border-color: rgba(147, 197, 253, 0.4); }
+.counter-chip { position: absolute; bottom: -8px; right: 6px; font-size: 10px; background: var(--bg2); border: 1px solid rgba(251, 191, 36, 0.5); color: var(--gold); padding: 1px 7px; border-radius: 99px; }
+.ability-btn {
+  font-size: 10.5px; color: var(--ink-dim); border: 1px dashed var(--line); padding: 2px 7px; border-radius: 7px; width: fit-content;
+}
+.ability-btn.playable { color: var(--magenta); border-color: rgba(232, 121, 249, 0.55); }
+
+/* mão do jogador */
+.hand {
+  position: absolute; bottom: 76px; left: 0; right: 0; display: flex; gap: 8px;
+  justify-content: center; padding: 10px 14px; overflow-x: auto; z-index: 20; scrollbar-width: none;
+}
+.hand::-webkit-scrollbar { display: none; }
+
+/* dock de comandos */
+.command-dock { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; flex: 2; }
+.dock-btn {
+  background: var(--glass); border: 1px solid var(--line); border-radius: 11px; padding: 9px 14px;
+  font-size: 12.5px; font-weight: 700; color: var(--ink-dim); backdrop-filter: blur(6px);
+  transition: transform 0.12s, box-shadow 0.18s, border-color 0.18s;
+}
+.dock-btn.playable { color: var(--ink); }
+.dock-btn.playable:hover { transform: translateY(-2px); }
+.attack-btn.playable { border-color: rgba(248, 113, 113, 0.6); color: #fecaca; box-shadow: 0 0 10px rgba(248, 113, 113, 0.25); }
+.attack-btn b { color: var(--gold); margin-left: 4px; }
+.ability-btn.dock-btn.playable { border-color: rgba(232, 121, 249, 0.55); color: var(--magenta); }
+.ability-btn small { color: var(--ink-dim); font-weight: 400; }
+.retreat-btn.playable { border-color: rgba(34, 211, 238, 0.5); color: var(--cyan); }
+.endturn-btn.playable { border-color: rgba(74, 222, 128, 0.55); color: #bbf7d0; }
+
+/* banners */
+.target-banner {
+  position: absolute; top: 12px; left: 50%; transform: translateX(-50%); z-index: 60;
+  background: var(--glass); backdrop-filter: blur(10px); border: 1.5px solid var(--cyan);
+  border-radius: 999px; padding: 10px 22px; display: flex; gap: 14px; align-items: center;
+  font-size: 14px; box-shadow: var(--neon); animation: toastIn 0.2s ease;
+}
+.cancel-target { background: transparent; border: none; color: var(--ink-dim); text-decoration: underline; font-size: 12px; }
+.tutorial-banner {
+  position: absolute; bottom: 170px; left: 50%; transform: translateX(-50%); z-index: 60;
+  background: linear-gradient(140deg, rgba(251, 191, 36, 0.16), var(--glass)); border: 1.5px solid rgba(251, 191, 36, 0.55);
+  border-radius: 16px; padding: 14px 22px; max-width: min(480px, 88vw); display: flex; flex-direction: column; gap: 6px;
+  box-shadow: var(--shadow); animation: toastIn 0.3s ease;
+}
+.tutorial-banner b { color: var(--gold); font-size: 15px; }
+.tutorial-banner span { font-size: 13.5px; }
+.skip-tutorial { position: absolute; right: -10px; top: -12px; background: var(--bg2); border: 1px solid var(--line); border-radius: 99px; font-size: 10.5px; padding: 3px 10px; color: var(--ink-dim); }
+
+.match-hud { position: absolute; top: 10px; right: 10px; display: flex; gap: 6px; z-index: 70; }
+.hud-btn { background: var(--glass); border: 1px solid var(--line); width: 34px; height: 34px; border-radius: 10px; font-size: 15px; }
+
+/* log */
+.log-drawer {
+  position: absolute; top: 52px; right: 10px; bottom: 90px; width: min(320px, 80vw); z-index: 80;
+  background: var(--glass); backdrop-filter: blur(12px); border: 1px solid var(--line); border-radius: 14px;
+  padding: 12px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; box-shadow: var(--shadow);
+}
+.log-line { font-size: 12px; color: var(--ink-dim); border-bottom: 1px dashed rgba(148, 163, 255, 0.08); padding: 3px 2px; }
+.log-line.p0 { color: var(--cyan); }
+.log-line.p1 { color: var(--magenta); }
+
+/* debug */
+.debug-panel {
+  position: absolute; bottom: 90px; left: 10px; width: min(360px, 86vw); max-height: 60vh; z-index: 90;
+  background: var(--glass); backdrop-filter: blur(12px); border: 1px solid rgba(232, 121, 249, 0.4);
+  border-radius: 14px; display: flex; flex-direction: column; overflow: hidden; box-shadow: var(--shadow);
+}
+.debug-head { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; border-bottom: 1px solid var(--line); color: var(--magenta); }
+.debug-tabs { display: flex; gap: 4px; padding: 6px 10px; }
+.debug-tabs button { background: transparent; border: 1px solid var(--line); border-radius: 8px; padding: 4px 10px; font-size: 11.5px; color: var(--ink-dim); }
+.debug-tabs button.on { color: var(--magenta); border-color: rgba(232, 121, 249, 0.5); }
+.debug-body { padding: 10px 12px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; font-size: 12px; }
+.debug-body label { display: flex; gap: 8px; align-items: center; color: var(--ink-dim); }
+.debug-body input, .debug-body select { background: var(--bg2); border: 1px solid var(--line); color: var(--ink); border-radius: 7px; padding: 4px 8px; width: 70px; }
+.debug-body button { background: var(--bg2); border: 1px solid var(--line); border-radius: 7px; padding: 5px 10px; font-size: 11.5px; }
+.debug-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; max-height: 200px; overflow-y: auto; }
+.debug-char { border: 1px solid var(--line); border-radius: 9px; padding: 6px 8px; }
+.debug-actions { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
+.debug-body pre { font-size: 10px; max-height: 200px; overflow: auto; white-space: pre-wrap; color: var(--ink-dim); }
+
+/* modais */
+.modal-backdrop {
+  position: fixed; inset: 0; background: rgba(4, 6, 14, 0.72); backdrop-filter: blur(4px);
+  z-index: 200; display: flex; align-items: center; justify-content: center; padding: 20px; animation: fadeIn 0.16s ease;
+}
+@keyframes fadeIn { from { opacity: 0; } }
+.modal { position: relative; animation: modalIn 0.2s ease; }
+@keyframes modalIn { from { transform: scale(0.92); opacity: 0; } }
+.modal.inspect .card-full { width: min(320px, 88vw); }
+.modal.pause {
+  background: var(--glass); border: 1px solid var(--line); border-radius: 18px; padding: 30px 40px;
+  display: flex; flex-direction: column; gap: 12px; min-width: 280px; align-items: stretch; text-align: center;
+}
+.close-btn {
+  position: absolute; top: 8px; right: 8px; z-index: 5; background: var(--bg2); border: 1px solid var(--line);
+  width: 28px; height: 28px; border-radius: 8px; color: var(--ink-dim);
+}
+
+/* FX */
+.fx-layer { position: fixed; inset: 0; pointer-events: none; z-index: 300; }
+.fx-float {
+  position: fixed; transform: translate(-50%, -50%); font-weight: 900; font-size: 22px;
+  animation: floatUp 1.5s ease-out forwards; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
+}
+.fx-float.big { font-size: 34px; }
+.fx-float.dmg { color: var(--red); }
+.fx-float.heal { color: var(--green); }
+.fx-float.upgrade { color: var(--gold); font-size: 26px; }
+.fx-float.ko { color: #fff; letter-spacing: 0.2em; font-size: 20px; }
+.fx-float.info { color: var(--cyan); }
+@keyframes floatUp {
+  0% { opacity: 0; transform: translate(-50%, -30%) scale(0.6); }
+  15% { opacity: 1; transform: translate(-50%, -60%) scale(1.15); }
+  100% { opacity: 0; transform: translate(-50%, -170%) scale(1); }
+}
+.fx-slash {
+  position: fixed; width: 120px; height: 3px; transform: translate(-50%, -50%) rotate(-35deg);
+  background: linear-gradient(90deg, transparent, #fff, var(--cyan), transparent);
+  animation: slash 0.5s ease-out forwards; filter: drop-shadow(0 0 8px var(--cyan));
+}
+@keyframes slash { from { opacity: 0; width: 0; } 30% { opacity: 1; width: 140px; } to { opacity: 0; width: 220px; } }
+.fx-burst { position: fixed; transform: translate(-50%, -50%); }
+.fx-burst i {
+  position: absolute; width: 6px; height: 6px; border-radius: 50%; background: var(--gold);
+  animation: burst 0.8s ease-out forwards; box-shadow: 0 0 8px var(--gold);
+}
+@keyframes burst {
+  from { transform: rotate(var(--ang)) translateY(0); opacity: 1; }
+  to { transform: rotate(var(--ang)) translateY(-70px); opacity: 0; }
+}
+
+/* ==========================================================================
+   ACESSIBILIDADE — foco visível em todo componente focável (item 41)
+   ========================================================================== */
+:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; border-radius: 4px; }
+.btn, .card-mini, .zone-pile, .board-card, .dock-btn, .menu-card { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
+
+/* ==========================================================================
+   RESPONSIVO
+   ========================================================================== */
+@media (max-width: 980px) {
+  .builder-layout { grid-template-columns: 1fr; grid-template-rows: 1fr auto; }
+  .deck-panel { max-height: 44vh; }
+  .menu-grid { grid-template-columns: repeat(2, minmax(150px, 1fr)); }
+  .active-zone { width: min(280px, 44vw); }
+}
+@media (max-width: 700px) {
+  .screen { padding: 10px; gap: 10px; }
+  .menu-grid { grid-template-columns: 1fr 1fr; width: 100%; }
+  .match-screen { padding: 6px; }
+  .opp-bar, .my-bar { gap: 8px; padding: 2px 4px; }
+  .pile-visual { width: 34px; height: 46px; }
+  .active-row { flex-direction: column; gap: 8px; }
+  .active-zone { width: min(340px, 92vw); }
+  .slot.empty.active-slot { min-height: 230px; }
+  .center-strip { flex-direction: row; gap: 8px; min-width: 0; flex-wrap: wrap; justify-content: center; }
+  .bench-row { flex-wrap: nowrap; overflow-x: auto; width: 100%; padding-bottom: 4px; }
+  .bench-row .board-card { min-width: 108px; max-width: 120px; }
+  .bc-attacks { display: none; }
+  .hand { bottom: 66px; justify-content: flex-start; }
+  .command-dock { justify-content: center; }
+  .dock-btn { padding: 8px 10px; font-size: 11.5px; }
+  .tutorial-banner { bottom: 150px; }
+  .my-bar { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, var(--bg0) 40%); z-index: 30; padding-bottom: 8px; }
+  .my-info { display: none; }
+  .card-full { width: 236px; }
+  .results-card { padding: 30px 22px; width: 92vw; }
+}
+
+/* Telas muito estreitas (360–420px): sem overflow, nada cortado (item 40) */
+@media (max-width: 420px) {
+  .menu-grid { grid-template-columns: 1fr; }
+  .card-full { width: min(206px, 84vw); }
+  .dock-btn { padding: 7px 8px; font-size: 10.5px; }
+  .bench-row .board-card { min-width: 88px; max-width: 102px; }
+  .active-zone { width: 94vw; }
+  .hand { bottom: 74px; }
+  .tutorial-banner { bottom: 168px; font-size: 12px; padding: 8px 10px; }
+  .results-card { width: 96vw; padding: 24px 14px; }
+  .filters { flex-wrap: wrap; }
+}
+@media (min-width: 1024px) {
+  .menu-grid { grid-template-columns: repeat(3, minmax(180px, 1fr)); }
+}
+
+/* ---------- JET TCG: edições, holo e identidade (cosmético) ---------- */
+.chip.edition-chip {
+  background: linear-gradient(135deg, rgba(212, 175, 55, 0.2), rgba(212, 175, 55, 0.08));
+  border-color: rgba(212, 175, 55, 0.55);
+  color: var(--gold-hi);
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  font-size: 10px;
+}
+.chip.edition-chip.ed-mvp { border-color: rgba(192, 197, 206, 0.6); color: #d7dce4; background: linear-gradient(135deg, rgba(192, 197, 206, 0.18), rgba(192, 197, 206, 0.05)); }
+.chip.edition-chip.ed-champion { border-color: rgba(245, 217, 122, 0.75); color: #ffe9a8; }
+.chip.edition-chip.ed-finals { border-color: rgba(248, 113, 113, 0.6); color: #fca5a5; }
+.chip.edition-chip.ed-icon { border-color: rgba(167, 139, 250, 0.6); color: #c4b5fd; }
+.chip.identity-chip { border-style: dashed; color: var(--ink-dim); font-size: 10px; }
+.chip.holo-chip {
+  background: linear-gradient(100deg, rgba(245, 217, 122, 0.25), rgba(255, 255, 255, 0.12), rgba(212, 175, 55, 0.2));
+  border-color: rgba(245, 217, 122, 0.7);
+  color: #fff3cd;
+  font-size: 10px;
+}
+.card.holo {
+  background-image: linear-gradient(135deg, rgba(245, 217, 122, 0.07) 0%, transparent 30%, rgba(255, 255, 255, 0.05) 50%, transparent 70%, rgba(212, 175, 55, 0.07) 100%);
+}
+.card.holo .card-art::after {
+  content: '';
+  position: absolute; inset: 0;
+  background: linear-gradient(115deg, transparent 40%, rgba(255, 248, 220, 0.14) 50%, transparent 60%);
+  pointer-events: none;
+}
+
+/* ---------- builder: variantes do agente ---------- */
+.variants-strip {
+  position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%);
+  display: flex; gap: 8px; align-items: center; z-index: 320;
+  background: var(--glass); border: 1px solid var(--line); border-radius: 999px;
+  padding: 8px 14px; backdrop-filter: blur(8px); box-shadow: var(--shadow);
+}
