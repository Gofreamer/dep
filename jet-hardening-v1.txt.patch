+      if (!me.active) e.dispatch({ type: 'SETUP_SET_ACTIVE', player: p, uid: me.hand.find((c) => c.kind === 'CHARACTER')!.uid });
+      else e.dispatch({ type: 'SETUP_DONE', player: p });
+    }
+  }
+  e.state.turn = 3;
