+
+const AC = (id: string, name: string, rarity: ActionDef['rarity'], effects: EffectStep[], o: { text?: string; restrictions?: ActionDef['restrictions']; tags?: string[] } = {}): ActionDef => ({
+  id,
+  kind: 'ACTION',
+  name,
+  text: o.text,
+  faction: 'neutro',
+  rarity,
+  tags: o.tags ?? ['tatica'],
+  art: { motif: 'action', seed: id },
+  effects,
+  restrictions: o.restrictions
+});
+
+/**
+ * Cartas de Ação — táticas de uso único.
+ */
+export const ACTIONS: ActionDef[] = [
+  AC('act-reforcos', 'Reforços', 'common',
+    [E('searchDeck', { filter: { kinds: ['CHARACTER'] }, amount: 1, to: 'hand', prompt: 'Escolha um personagem' })],
+    { text: 'Busque 1 personagem no seu baralho.' }),
+  AC('act-treinamento', 'Treinamento Intensivo', 'uncommon',
+    [E('searchDeck', { filter: { kinds: ['CHARACTER'], stageMin: 1 }, amount: 1, to: 'hand', prompt: 'Escolha um personagem de Estágio 1+' })],
+    { text: 'Busque 1 personagem de Estágio 1 ou superior no seu baralho.' }),
+  AC('act-chamado', 'Chamado das Profundezas', 'uncommon',
