+    { text: 'Recupere 1 personagem do seu descarte.' }),
+  AC('act-reciclagem', 'Reciclagem', 'common',
+    [E('returnToHand', { from: 'discard', filter: { kinds: ['RESOURCE'] }, amount: 2 })],
+    { text: 'Recupere até 2 recursos do seu descarte.' }),
+  AC('act-ponte', 'Ponte Dimensional', 'rare',
+    [E('searchDeck', { amount: 1, to: 'hand', prompt: 'Escolha qualquer carta do baralho' })],
+    { text: 'Busque qualquer carta no seu baralho.', restrictions: [{ type: 'oncePerTurn' }] }),
+  AC('act-inspiracao', 'Inspiração', 'common',
+    [E('drawCards', { amount: 3 })],
+    { text: 'Compre 3 cartas.' }),
+  AC('act-escambo', 'Escambo', 'common',
+    [E('drawCards', { amount: 2 }), E('discardCards', { amount: 1, prompt: 'Descarte 1 carta' })],
+    { text: 'Compre 2 cartas e descarte 1.' }),
+  AC('act-soro', 'Soro Vital', 'common',
+    [E('heal', { target: 'activeAlly', amount: 50 })],
+    { text: 'Cure 50 do seu personagem ativo.' }),
+  AC('act-balsamo', 'Bálsamo Coletivo', 'uncommon',
+    [E('heal', { target: 'allAllies', count: 'all', amount: 20 })],
